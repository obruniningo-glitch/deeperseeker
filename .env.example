# Api key would be used to access api endpoints
DEEPSEEKER_API_KEY=dseeker
# Login Username for dashboard
DEEPSEEKER_ADMIN_USER=admin
#Login Password for dashboard
DEEPSEEKER_ADMIN_PASSWORD=admin
# Bind address for bare-metal runs (127.0.0.1 = local only, 0.0.0.0 = expose)
HOST=127.0.0.1
PORT=4000

# Prompt compaction (context-size control for long agentic chats)
# Total token budget for the first-message (full-history) injection.
DEEPSEEKER_PROMPT_BUDGET=24000
# Max tokens per individual tool result before head+tail clipping.
DEEPSEEKER_TOOL_RESULT_CLIP=4000
# How many recent messages stay verbatim in injected history.
DEEPSEEKER_HISTORY_RECENT_TURNS=6

# Signature window K (tolerant session-cache keys that survive client-side
# context compaction). 0 = old full-history behavior. Changing K invalidates
# all cached sessions once (they age back in via new chats).
DEEPSEEKER_SIG_WINDOW_K=8
